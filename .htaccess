DirectoryIndex index.php public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Already inside /public — stop rewriting (avoids loops on shared hosting).
    RewriteRule ^public/ - [L]

    # Existing files/folders at project root (e.g. this index.php) can be served.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through Laravel's public front controller.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
