DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Someone hitting /public/... directly — let public/.htaccess handle it.
    RewriteRule ^public/ - [L]

    # Real files/folders in the project root (this index.php, robots.txt, etc.).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Vite/CSS/JS and other public assets. Explicit rules — relative "-f" checks
    # fail on some cPanel subdirectory setups and left /build/* as blank-page 404s.
    RewriteRule ^build/(.*)$ public/build/$1 [L]
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]
    RewriteRule ^brand/(.*)$ public/brand/$1 [L]
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]

    # App routes through the root front controller so SCRIPT_NAME stays
    # /pr1mesocials/index.php and Laravel sees /login (not /pr1mesocials/login).
    RewriteRule ^ index.php [L]
</IfModule>
